generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String       @id @default(uuid())
  telegramId       String       @unique
  name             String
  role             String       @default("EMPLOYEE") // ADMIN, MANAGER, EMPLOYEE
  phone            String?
  active           Boolean      @default(true)
  canUseAttendance Boolean      @default(true)
  canUseSales      Boolean      @default(true)
  canUseExpenses   Boolean      @default(true)
  canUseOrders      Boolean              @default(true)
  canUseZapchas     Boolean              @default(true)
  canManageZapchas  Boolean              @default(false)
  workStartTime     String               @default("09:00")
  workEndTime       String               @default("18:00")
  language          String               @default("uz") // uz, ru
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  Attendance        Attendance[]
  Sale              Sale[]
  Expense           Expense[]
  assignedOrders    Order[]              @relation("AssignedOrders")
  createdOrders     Order[]              @relation("CreatedOrders")
  zapchasLogs       ZapchasTransaction[] @relation("ZapchasActor")
  zapchasSales      ZapchasSale[]        @relation("ZapchasSeller")
}

model Attendance {
  id           String           @id @default(uuid())
  user         User             @relation(fields: [userId], references: [id])
  userId       String
  date         DateTime         // Represents the day
  checkInTime  DateTime?
  checkOutTime DateTime?
  gpsLat       Float?
  gpsLng       Float?
  status       String           @default("ON_TIME") // ON_TIME, LATE, ABSENT
  reason       String?          // If late or out of zone
  lateMinutes  Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Sale {
  id            String        @id @default(uuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  customerName  String?
  customerPhone String?
  totalPrice    Float         @default(0)
  advance       Float         @default(0)
  balance       Float         @default(0)
  paymentMethod String        @default("CASH") // CASH, CARD, INSTALLMENT
  status        String        @default("COMPLETED") // COMPLETED, INCOMPLETE
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]
  orders        Order[]
  payments      SalePayment[]
}

model SaleItem {
  id        String   @id @default(uuid())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  name      String
  price     Float
}

model Settings {
  id        String   @id @default(uuid())
  storeLat  Float
  storeLng  Float
  radius    Int      @default(50) // in meters
  updatedAt DateTime @updatedAt
}


model Expense {
  id            String   @id @default(uuid())
  userId        String
  amount        Float
  reason        String
  paymentMethod String   @default("CASH") // CASH, CARD, ADVANCE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Order {
  id           String    @id @default(uuid())
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId       String
  name         String
  price        Float
  description  String?
  deadline     DateTime?
  assignedTo   User?     @relation("AssignedOrders", fields: [assignedToId], references: [id])
  assignedToId String?
  creator      User      @relation("CreatedOrders", fields: [creatorId], references: [id])
  creatorId    String
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PaymentMethod {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalePayment {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // DELETE_SALE, DELETE_EXPENSE, CLOSE_SHIFT, OPEN_SHIFT, PAY_DEBT
  entity    String   // Sale, Expense, CashShift
  entityId  String?
  details   String
  user      String?  // Who performed the action
  createdAt DateTime @default(now())
}

model CashShift {
  id           String    @id @default(uuid())
  openedBy     String    // User name or ID
  closedBy     String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  startAmount  Float     @default(0) // Ertalabki boshlang'ich kassa qoldig'i
  cashIn       Float     @default(0) // Naqd savdo tushumlari
  cashOut      Float     @default(0) // Naqd xarajatlar
  expectedCash Float     @default(0) // startAmount + cashIn - cashOut
  actualCash   Float?    // Kechqurun sanab topshirilgan haqiqiy naqd pul
  difference   Float?    // actualCash - expectedCash (kamomad yoki ortiqcha)
  note         String?
  status       String    @default("OPEN") // OPEN, CLOSED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ZapchasPart {
  id           String               @id @default(uuid())
  name         String               @unique
  unit         String               @default("dona") // dona, juft, metr, komplekt, kg
  quantity     Int                  @default(0)
  minQuantity  Int                  @default(0)
  price        Float?
  note         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions ZapchasTransaction[]
}

model ZapchasSale {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation("ZapchasSeller", fields: [userId], references: [id])
  customerName  String?
  customerPhone String?
  totalPrice    Float                @default(0)
  advance       Float                @default(0)
  balance       Float                @default(0)
  paymentMethod String               @default("Naqd")
  status        String               @default("COMPLETED") // COMPLETED, INCOMPLETE
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  transactions  ZapchasTransaction[]
  payments      ZapchasSalePayment[]
}

model ZapchasSalePayment {
  id        String      @id @default(uuid())
  saleId    String
  sale      ZapchasSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String
  amount    Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ZapchasTransaction {
  id            String       @id @default(uuid())
  partId        String
  part          ZapchasPart  @relation(fields: [partId], references: [id], onDelete: Cascade)
  zapchasSaleId String?
  zapchasSale   ZapchasSale? @relation(fields: [zapchasSaleId], references: [id], onDelete: Cascade)
  type          String       // IN, OUT, ADJUST
  quantity      Int
  quantityDelta Int
  balanceAfter  Int
  unitPrice     Float?
  totalPrice    Float?
  customerName  String?
  note          String?
  userId        String
  user          User         @relation("ZapchasActor", fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
